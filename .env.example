# Copy to .env for local development. Docker Compose and the dev server both read it.
POSTGRES_USER=franks
POSTGRES_PASSWORD=franks
POSTGRES_DB=franks
DATABASE_URL=postgres://franks:franks@localhost:5432/franks
PORT=3000
# Only send the session cookie over HTTPS. Leave false for local http; set true when hosted.
COOKIE_SECURE=false
# Addresses of a reverse proxy in front of the app (e.g. uniquelocal for Caddy on the Docker
# network), so login rate limits see each visitor's IP. Leave unset when nothing is in front.
TRUST_PROXY=
